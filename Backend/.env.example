# Backend/.env  — copy to .env and fill in (gitignored)
# Loaded automatically by database.py; values here override real env vars.

RESEND_API_KEY=

SUPABASE_URL=
# Use the service_role key so the API can read/write tables without RLS.
# Never expose this key to the frontend.
SUPABASE_KEY=

# Optional — checkout falls back to mock mode when STRIPE_SECRET_KEY is unset.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
