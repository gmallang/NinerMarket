# Backend/.env  — copy to .env and fill in (gitignored)
# Loaded automatically by database.py; values here override real env vars.

RESEND_API_KEY=

SUPABASE_URL=
# Use the service_role key so the API can read/write tables without RLS.
# Never expose this key to the frontend.
SUPABASE_KEY=

# The anon/public key (same one used by the frontend). Used ONLY for firing
# Realtime broadcasts — the service_role key returns 202 but the message is
# never actually delivered to subscribers (confirmed against the live
# project). Safe to reuse the public key here; these broadcasts never carry
# real message content, just "go refetch"/typing signals.
SUPABASE_ANON_KEY=

# Google OAuth client ID (web application) for real "Sign in with Google".
GOOGLE_CLIENT_ID=

# Secret used to sign session tokens. Required in production (Vercel) — any
# long random string, e.g. generate with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated list of frontend origins allowed to call this API, e.g.
# https://ninermarket.vercel.app,https://ninermarket.app
# Leave blank in local dev; set this before going live so the API stops
# accepting requests from arbitrary origins.
ALLOWED_ORIGINS=

# Origin of the deployed frontend, used to redirect the browser back after the
# Google redirect-mode login (e.g. https://ninermarket.com).
# Leave blank in local dev (defaults to http://localhost:5173).
FRONTEND_URL=

# Secret used to sign session tokens. Set a stable value so sessions survive restarts.
SESSION_SECRET=change-me-to-a-long-random-hex-string

# Web Push (Push API) — VAPID keypair. Used so notifications reach devices even
# when no NinerMarket tab is open. Generate a keypair once, then put:
#   - VAPID_PUBLIC_KEY  -> backend env (returned to the browser to subscribe)
#   - VAPID_PRIVATE_KEY -> backend env (used to sign/encrypt outgoing pushes)
#   - VAPID_SUBJECT     -> optional contact (defaults to mailto:support@ninermarket.com)
# Both keys MUST be set in production or the push prompt shows
# "Not available yet" and no OS notifications are delivered.
#
# Generate with Python (the py-webpush / py_vapid package is already a
# dependency of the backend, so `pip install py-vapid` or reuse the venv):
#
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.public_key.urlsafe); print(v.private_key.urlsafe)"
#
# or with npx:
#
#   npx web-push generate-vapid-keys
#
# Copy the two lines into Vercel > project > Settings > Environment Variables.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@ninermarket.com
