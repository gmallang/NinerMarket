# Backend/.env  — copy to .env and fill in (gitignored)
# Loaded automatically by database.py; values here override real env vars.

RESEND_API_KEY=

SUPABASE_URL=
# Use the service_role key so the API can read/write tables without RLS.
# Never expose this key to the frontend.
SUPABASE_KEY=

# Google OAuth client ID (web application) for real "Sign in with Google".
GOOGLE_CLIENT_ID=

# Secret used to sign session tokens. Required in production (Vercel) — any
# long random string, e.g. generate with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated list of frontend origins allowed to call this API, e.g.
# https://ninermarket.vercel.app,https://ninermarket.app
# Leave blank in local dev; set this before going live so the API stops
# accepting requests from arbitrary origins.
ALLOWED_ORIGINS=

# Origin of the deployed frontend, used to redirect the browser back after the
# Google redirect-mode login (e.g. https://ninermarket.com).
# Leave blank in local dev (defaults to http://localhost:5173).
FRONTEND_URL=
