# Copy this file to frontend/android/keystore.properties (git-ignored) to sign
# release builds. Create the keystore once and keep it somewhere safe - losing
# it means you can never update the app on Play under the same listing.
#
#   keytool -genkeypair -v -keystore ninermarket-release.jks -alias ninermarket \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Paths are relative to frontend/android/app/.
storeFile=../ninermarket-release.jks
storePassword=change-me
keyAlias=ninermarket
keyPassword=change-me
